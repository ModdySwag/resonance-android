<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing in this app is worth leaving the device: the sessions are synthesised locally
     and the preferences are a handful of timbres. Cloud backup and device-to-device
     transfer are therefore excluded rather than silently copying the WebView store. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
